#!/usr/bin/env bash
# SessionStart hook for communication-style plugin.
# Injects the communicating-tersely skill so its "every response" rule
# is present without relying on the model to invoke it each turn.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

skill_content=$(cat "${PLUGIN_ROOT}/skills/communicating-tersely/SKILL.md" 2>&1 || echo "Error reading communicating-tersely skill")

# Single-pass JSON string escaping via bash parameter substitution.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

skill_escaped=$(escape_for_json "$skill_content")
session_context="**communication-style:communicating-tersely — governs every response in this session:**\n\n${skill_escaped}"

# Claude Code reads hookSpecificOutput.additionalContext; other harnesses
# read additionalContext (top-level). Emit only what this platform consumes.
if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"
else
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context"
fi

exit 0
